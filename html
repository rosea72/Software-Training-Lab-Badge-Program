            { id: "ae-3", software: "After Effects", level: 3, title: "Expert Motion Systems", icon: `<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>`, requirements: ["Graph Mode (Speed/Value)", "Text & Shape Animators", "Trim paths & Wiggle", "3D Lights & Camera", "Content aware fill", "3D Extrusion & Track Camera"] },

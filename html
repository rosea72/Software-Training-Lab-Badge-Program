            { id: "ps-2", software: "Photoshop", level: 2, title: "Composition & Advanced Tools", icon: `<rect width="8" height="8" x="2" y="2" rx="2"/><path d="M14 2c1.1 0 2 .9 2 2v4c0 1.1-.9 2-2 2"/><path d="M20 2c1.1 0 2 .9 2 2v4c0 1.1-.9 2-2 2"/>`, requirements: ["Selection tools (Marquee, Lasso, etc)", "Layers panel advanced features", "Combining 2 images using masks", "Filters (Unsharp Mask, Blur)", "Creating a new document (CMYK vs. RGB)", "Brush panel & Eyedropper tool", "Gradient tool & Shape tools", "Type tool & Layer Styles", "Photomerge", "Patch tool & Content-aware fill", "Exporting"] },

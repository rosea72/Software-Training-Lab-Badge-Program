            { id: "id-4", software: "InDesign", level: 4, title: "Mastery of Styles", icon: `<circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 6v6"/>`, requirements: ["Training lessons 9-13", "Multi-page brochure", "Paragraph & Character Styles", "Bullets & Numbering", "Tables & Spanning columns"] },

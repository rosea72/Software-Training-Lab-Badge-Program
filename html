            { id: "wd-2", software: "Word", level: 2, title: "Advanced Formatting", icon: `<rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18M9 21V9"/>`, requirements: ["Custom Styles", "Mail Merge", "Form controls", "Track Changes & Comments", "Advanced Citations"] },
            { id: "wd-3", software: "Word", level: 3, title: "Expert Efficiency", icon: `<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>`, requirements: ["Advanced Templates", "Macros", "Building Blocks", "Document Protection", "Advanced Field Codes"] },
            { id: "et-1", software: "ETD", level: 1, title: "Intro to Formatting", icon: `<path d="M22 10v6M2 10l10-5 10 5-10 5z"/>`, requirements: ["Basic ETD formatting", "Identify margin/layout errors", "Submission lifecycle"] },
            { id: "et-2", software: "ETD", level: 2, title: "Senior ETD Consultant", icon: `<circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>`, requirements: ["Two semesters experience", "Wiki Knowledge Base", "Word Advanced menus", "Notify Sage of changes"] },
            { id: "dv-1", software: "DaVinci Resolve", level: 1, title: "Video Editing Essentials", icon: `<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/><line x1="21.17" x2="12" y1="8" y2="8"/>`, requirements: ["Media & Cut Tabs", "Edit Tab: Razor/Fades", "Unlinking audio", "Mixer sliders", "Keyframing rubber band", "Deliver Export"] },
            { id: "dv-2", software: "DaVinci Resolve", level: 2, title: "Advanced Fusion & Color", icon: `<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>`, requirements: ["Fusion Nodes & Merging", "Spline adjustment", "Color curves & wheels", "Keyframing color", "Background noise removal"] },
            { id: "pc-1", software: "Procreate", level: 1, title: "Digital Illustration Basics", icon: `<path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/>`, requirements: ["Canvas setup & resolution", "Brush settings & Opacity", "Layer management", "Alpha Lock", "Basic selection"] },
            { id: "pc-2", software: "Procreate", level: 2, title: "Advanced Illustration", icon: `<circle cx="13.5" cy="6.5" r=".5"/><circle cx="17.5" cy="10.5" r=".5"/><circle cx="8.5" cy="7.5" r=".5"/><circle cx="6.5" cy="12.5" r=".5"/>`, requirements: ["Advanced Brush panel", "Clipping masks", "Gaussian blur & Liquify", "Automatic selection", "Animation Assist", "Time-lapse export"] }
        ];

        const firebaseConfig = JSON.parse(window.__firebase_config || '{}');
        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);
        const appId = window.__app_id || 'badge-tracker';

        let state = {
            currentUser: null,
            usersData: {},
            selectedBadge: null,
            searchQuery: '',
            tab: 'all',
            isSage: false,
            unsubscribeUsers: null
        };

        const init = async () => {
            const initAuth = async () => {
                if (typeof window.__initial_auth_token !== 'undefined' && window.__initial_auth_token) {
                    await signInWithCustomToken(auth, window.__initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }
            };
            await initAuth();

            onAuthStateChanged(auth, (user) => {
                if (!user) return;
                const publicDataCol = collection(db, 'artifacts', appId, 'public', 'data', 'users');
                if (state.unsubscribeUsers) state.unsubscribeUsers();
                state.unsubscribeUsers = onSnapshot(publicDataCol, (snapshot) => {
                    snapshot.forEach(doc => { state.usersData[doc.id] = doc.data(); });
                    renderAll();
                });
                const savedName = localStorage.getItem('stl_user');
                if (savedName) login(savedName);
            });
        };

        const login = async (name) => {
            if (!auth.currentUser) return;
            state.currentUser = name;
            localStorage.setItem('stl_user', name);
            const userRef = doc(db, 'artifacts', appId, 'public', 'data', 'users', name);
            const userSnap = await getDoc(userRef);
            if (!userSnap.exists()) {
                await setDoc(userRef, { name, earned: [], submissions: {}, checklists: {} });
            }
            document.getElementById('onboarding').classList.add('hidden');
            document.getElementById('app').classList.remove('hidden');
            document.getElementById('current-user-name').textContent = name;
            renderAll();
        };

        const renderAll = () => {
            if (!document.getElementById('dashboard-view').classList.contains('hidden')) renderDashboard();
            if (!document.getElementById('admin-view').classList.contains('hidden')) renderAdmin();
            if (!document.getElementById('detail-view').classList.contains('hidden')) renderDetail();
        };

        const renderDashboard = () => {
            const data = state.usersData[state.currentUser] || { earned: [], submissions: {} };
            let filtered = BADGE_DATA;
            if (state.tab === 'earned') filtered = BADGE_DATA.filter(b => data.earned.includes(b.id));
            if (state.searchQuery) {
                const q = state.searchQuery.toLowerCase();
                filtered = filtered.filter(b => b.software.toLowerCase().includes(q) || b.title.toLowerCase().includes(q));
            }
            document.getElementById('stat-total').textContent = BADGE_DATA.length;
            document.getElementById('stat-earned').textContent = data.earned.length;
            document.getElementById('badge-grid').innerHTML = filtered.map(badge => {
                const isEarned = data.earned.includes(badge.id);
                return `
                    <div class="badge-card ${isEarned ? 'earned' : ''}" onclick="window.selectBadge('${badge.id}')">
                        <div class="badge-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">${badge.icon}</svg></div>
                        <div class="badge-title">${badge.software}</div>
                        <div class="badge-level">Level ${badge.level}</div>
                        ${isEarned ? '<svg class="badge-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>' : ''}
                    </div>
                `;
            }).join('');
        };

        window.selectBadge = (id) => {
            state.selectedBadge = BADGE_DATA.find(b => b.id === id);
            document.getElementById('dashboard-view').classList.add('hidden');
            document.getElementById('admin-view').classList.add('hidden');
            document.getElementById('detail-view').classList.remove('hidden');
            document.getElementById('back-btn').classList.remove('hidden');
            renderDetail();
        };

        const renderDetail = () => {
            const badge = state.selectedBadge;
            const data = state.usersData[state.currentUser] || { earned: [], submissions: {}, checklists: {} };
            const isEarned = data.earned.includes(badge.id);
            const checklist = data.checklists?.[badge.id] || [];
            document.getElementById('detail-title').textContent = `${badge.software} Level ${badge.level}`;
            document.getElementById('detail-status-text').textContent = isEarned ? 'Verified Professional' : 'Candidate';
            document.getElementById('status-card').className = `status-card ${isEarned ? 'earned' : ''}`;
            document.getElementById('detail-icon-box').innerHTML = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">${badge.icon}</svg>`;
            document.getElementById('requirements-list').innerHTML = badge.requirements.map((req, idx) => {
                const isChecked = checklist.includes(idx);
                return `<li class="requirement-item" onclick="window.toggleReq(${idx})"><div class="requirement-checkbox ${isChecked ? 'checked' : ''}">${isChecked ? '✓' : ''}</div><span class="requirement-text">${req}</span></li>`;
            }).join('');
            document.getElementById('sub-link').value = data.submissions?.[badge.id] || '';
            const allChecked = checklist.length === badge.requirements.length;
            const eb = document.getElementById('endorse-btn');
            eb.disabled = !allChecked;
            eb.textContent = isEarned ? "Revoke Endorsement" : "Endorse Badge";
            eb.className = isEarned ? "btn-endorse revoke" : "btn-endorse";
            document.getElementById('endorse-warning').classList.toggle('hidden', allChecked);
        };

        window.toggleReq = async (idx) => {
            if (!auth.currentUser) return;
            const badge = state.selectedBadge;
            const userRef = doc(db, 'artifacts', appId, 'public', 'data', 'users', state.currentUser);
            const currentData = state.usersData[state.currentUser];
            let list = currentData.checklists?.[badge.id] || [];
            if (list.includes(idx)) list = list.filter(i => i !== idx); else list.push(idx);
            await updateDoc(userRef, { [`checklists.${badge.id}`]: list });
            renderDetail();
        };

        const renderAdmin = () => {
            const list = document.getElementById('admin-list');
            const users = Object.values(state.usersData);
            list.innerHTML = users.map(u => `
                <div class="user-card">
                    <div class="user-card-header">
                        <span class="user-card-name">${u.name}</span>
                        <button class="btn-submit" style="width:auto; margin:0; padding:0.5rem 1rem;" onclick="window.viewUser('${u.name}')">View Profile</button>
                    </div>
                    <div style="font-size:0.875rem; color:var(--text-muted); margin-top:0.5rem;">Badges: ${u.earned?.length || 0} / ${BADGE_DATA.length}</div>
                </div>
            `).join('');
        };

        window.viewUser = (name) => {
            state.currentUser = name;
            document.getElementById('current-user-name').textContent = name;
            document.getElementById('admin-view').classList.add('hidden');
            document.getElementById('dashboard-view').classList.remove('hidden');
            renderDashboard();
        };

        document.getElementById('start-btn').onclick = () => {
            const name = document.getElementById('user-name-input').value.trim();
            if (name) login(name);
        };
        document.getElementById('back-btn').onclick = () => {
            document.getElementById('detail-view').classList.add('hidden');
            document.getElementById('admin-view').classList.add('hidden');
            document.getElementById('dashboard-view').classList.remove('hidden');
            document.getElementById('back-btn').classList.add('hidden');
            renderDashboard();
        };
        document.getElementById('admin-btn').onclick = () => {
            document.getElementById('dashboard-view').classList.add('hidden');
            document.getElementById('detail-view').classList.add('hidden');
            document.getElementById('admin-view').classList.remove('hidden');
            document.getElementById('back-btn').classList.remove('hidden');
            renderAdmin();
        };
        document.getElementById('search-input').oninput = (e) => { state.searchQuery = e.target.value; renderDashboard(); };
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.onclick = () => {
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                state.tab = btn.dataset.tab;
                renderDashboard();
            };
        });
        document.getElementById('save-sub-btn').onclick = async () => {
            const link = document.getElementById('sub-link').value.trim();
            const userRef = doc(db, 'artifacts', appId, 'public', 'data', 'users', state.currentUser);
            await updateDoc(userRef, { [`submissions.${state.selectedBadge.id}`]: link });
            notify("Link Saved");
        };
        document.getElementById('sage-toggle-btn').onclick = () => {
            if (state.isSage) { state.isSage = false; document.getElementById('sage-panel').classList.add('hidden'); document.getElementById('sage-toggle-btn').textContent = "Unlock Sage Mode"; }
            else { document.getElementById('password-modal').classList.remove('hidden'); }
        };
        document.getElementById('confirm-sage').onclick = () => {
            if (document.getElementById('sage-password').value === "STL Lead") {
                state.isSage = true; document.getElementById('password-modal').classList.add('hidden');
                document.getElementById('sage-panel').classList.remove('hidden');
                document.getElementById('sage-toggle-btn').textContent = "Sage Mode Active";
                document.getElementById('sage-password').value = "";
            } else notify("Wrong Password");
        };
        document.getElementById('cancel-sage').onclick = () => document.getElementById('password-modal').classList.add('hidden');
        document.getElementById('endorse-btn').onclick = async () => {
            const badge = state.selectedBadge;
            const userRef = doc(db, 'artifacts', appId, 'public', 'data', 'users', state.currentUser);
            const uData = state.usersData[state.currentUser];
            let earned = uData.earned || [];
            if (earned.includes(badge.id)) earned = earned.filter(id => id !== badge.id); else earned.push(badge.id);
            await updateDoc(userRef, { earned });
            renderDetail();
        };
        document.getElementById('logout-btn').onclick = () => { localStorage.removeItem('stl_user'); location.reload(); };
        function notify(msg) {
            const el = document.getElementById('notif'); el.textContent = msg; el.classList.remove('hidden');
            setTimeout(() => el.classList.add('hidden'), 3000);
        }
        init();
    </script>
</body>
</html>

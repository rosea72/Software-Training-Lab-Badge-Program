            { id: "ai-1", software: "Illustrator", level: 1, title: "Vector Foundations", icon: `<path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/>`, requirements: ["Selection & Direct Selection", "Pen tool (straight/curved)", "Shape tools & Builder", "Fills and Strokes", "Swatches & Layers", "Navigating drawing"] },
            { id: "ai-2", software: "Illustrator", level: 2, title: "Organic Drawing & Advanced Aesthetics", icon: `<circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/>`, requirements: ["Pencil, Brush, Curvature", "Eraser & Knife tools", "Gradients, Transparency", "Live paint & Color themes", "Advanced stroke settings", "Appearance panel", "Artboards, Rotating/Reflecting"] },

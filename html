            { id: "id-2", software: "InDesign", level: 2, title: "Publication Design", icon: `<path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/>`, requirements: ["Training lessons 1-4", "6-page magazine spread", "Facing pages & Page numbers", "Threaded text frames", "Parent page elements", "Links panel management"] },
